<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vocab_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vocab_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/vocab_widget_badge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/vocab_widget_badge_background"
            android:gravity="center"
            android:text="&#54620;"
            android:textColor="#0E3A5F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vocab_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kata Korea Hari Ini"
            android:textColor="#0E3A5F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vocab_widget_open_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vocab_widget_pill_background"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:text="Buka"
            android:textColor="#0E3A5F"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/vocab_widget_english"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="bottom"
        android:maxLines="2"
        android:text="hello"
        android:textColor="#0E3A5F"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vocab_widget_korean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="annyeonghaseyo"
        android:textColor="#8D5E34"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/vocab_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="1/5 &#8226; ketuk kartu untuk kata berikutnya"
        android:textColor="#475569"
        android:textSize="10sp" />
</LinearLayout>
